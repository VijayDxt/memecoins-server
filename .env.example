# ── Jupiter ──────────────────────────────────────────────────────────────────
# Obtain a free key at https://portal.jup.ag
JUPITER_API_KEY=your_jupiter_api_key_here

# ── Firebase ──────────────────────────────────────────────────────────────────
# Paste the ENTIRE contents of your Firebase service account JSON as a single
# string value. Do NOT base64-encode it — just paste the raw JSON here.
# Generate one at: Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# ── Helius (reserved for future passes) ──────────────────────────────────────
# Not used in this pass. Wire it up now so future features can read it.
HELIUS_API_KEY=your_helius_api_key_here

# ── Worker tuning (optional) ──────────────────────────────────────────────────
# How often to poll, in milliseconds. Defaults to 20000 (20 seconds).
# POLL_INTERVAL_MS=20000
